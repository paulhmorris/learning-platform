{
  "name": "learning-platform",
  "private": true,
  "type": "module",
  "sideEffects": [
    "./instrument.server.mjs"
  ],
  "scripts": {
    "build": "react-router build",
    "copytypes": "node copyTypes.mjs && npx oxfmt",
    "dev": "react-router dev",
    "email:dev": "email dev --port 3001 --dir ./app/emails",
    "format": "oxfmt",
    "lint": "oxlint --fix",
    "lint:prepush": "oxlint --max-warnings=0",
    "ngrok": "ngrok http --domain=legally-sterling-crayfish.ngrok-free.app 3000 --host-header localhost:3000",
    "postinstall": "prisma generate --no-hints && patch-package",
    "prepare": "husky",
    "prepush": "run-p lint:prepush typecheck build test",
    "start": "node ./build/server/index.js",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "trigger": "npx trigger.dev@4.4.2 dev",
    "typecheck": "tsgo",
    "typegen": "react-router typegen"
  },
